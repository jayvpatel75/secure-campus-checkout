{
  "name": "secure-campus-checkout",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible campus equipment lending with server-enforced permissions and an audit trail.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "seed:demo": "tsx server/seed.ts",
    "user:create": "tsx server/create-user.ts",
    "format": "prettier --write .",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.10.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
